# API port. Defaults to 3001 when unset. Railway injects its own PORT.
PORT=3001

# development locally, so the dev server does not serve client/dist. Railway uses production.
NODE_ENV=development

# SQLite file. A relative path resolves from the repo root. Unset still uses <repo>/dev.db.
DB_PATH=./dev.db

# mock labels work offline. grok calls xAI and needs XAI_API_KEY and GROK_MODEL.
AI_PROVIDER=mock

# xAI key. Required only when AI_PROVIDER=grok. This value is a placeholder.
XAI_API_KEY=replace-with-your-key

# Model name sent to xAI. Required only when AI_PROVIDER=grok.
GROK_MODEL=grok-4.20-0309-non-reasoning

# Read-only GitHub token for Sync. Placeholder only. The demo seed does not call GitHub.
GITHUB_TOKEN=replace-with-a-read-only-token

# Basic-auth username. Used only when SITE_PASSWORD is non-empty. Default is maestro.
SITE_USER=maestro

# Basic-auth password for a hosted deploy. Leave empty so the local gate stays off.
SITE_PASSWORD=

# Insert the StudyBuddy demo once, on server startup, into DB_PATH.
# Off unless this is exactly 1. The public Railway site sets it.
# A finished seed writes a done marker. Later startups insert nothing.
# Deleting the demo leaves the marker, so the team stays deleted.
# Leave it commented for local development. `npm run seed` still seeds a local file.
# SEED_DEMO=1
