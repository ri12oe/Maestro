# GitHub personal access token (read-only, repo scope)
GITHUB_TOKEN=your_github_pat_here

# SQLite database file path (defaults to ./dev.db in repo root)
DB_PATH=./dev.db

# Server port (defaults to 3001)
PORT=3001

# AI provider: 'mock' for local dev/tests, 'watsonx' for production
AI_PROVIDER=mock

# watsonx.ai (required when AI_PROVIDER=watsonx)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
