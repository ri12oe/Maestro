# GitHub personal access token (read-only, repo scope)
GITHUB_TOKEN=your_github_pat_here

# SQLite file. A relative path is resolved from the repo root.
# ./dev.db is <repo>/dev.db, which is also the default when DB_PATH is unset.
# An absolute path is used as given (Railway: DB_PATH=/data/maestro.db).
DB_PATH=./dev.db

# Server port (defaults to 3001)
PORT=3001

# AI provider: 'mock' for local dev/tests, 'grok' for production
AI_PROVIDER=mock

# xAI Grok (required when AI_PROVIDER=grok)
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-4.20-0309-non-reasoning

# Optional: password-protect a hosted deploy (leave unset locally)
# SITE_USER=maestro
# SITE_PASSWORD=choose-a-long-password
